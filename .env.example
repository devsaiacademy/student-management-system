# Copy to `.env` at the repo root and fill in real values.
# This is the only .env the app reads: apps/web/next.config.ts and
# packages/env load it from here.

NODE_ENV=development

# Postgres (Supabase) connection string, used by the API and drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Allowed origin for API requests (optional).
CORS_ORIGIN=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: only needed to verify Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Shared secret the cron endpoint expects.
CRON_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name. Defaults to fee_due_reminder when unset.
WHATSAPP_OVERDUE_TEMPLATE=fee_due_reminder
# Approved utility template sent after a successful Razorpay payment.
# Defaults to payment_received when unset.
WHATSAPP_PAYMENT_RECEIVED_TEMPLATE=payment_received

# Sentry (errors only). DSN from Sentry > Settings > Projects > Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload. Set in Vercel, never commit.
SENTRY_AUTH_TOKEN=
